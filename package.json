{
  "name": "pje-trf5-scraper",
  "version": "1.0.0",
  "description": "Scraper de la Consulta Pública del PJe del TRF5. HTTP puro, sin automatización de navegador.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/cli/index.ts",
    "scrape": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:download": "tsx scripts/smoke-download.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^5.0.5",
    "cheerio": "^1.0.0",
    "iconv-lite": "^0.6.3",
    "tough-cookie": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "nock": "^14.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
